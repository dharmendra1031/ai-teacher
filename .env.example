# Copy to .env for local Compose use. Never use these values outside local development.
POSTGRES_DB=ai_teacher
POSTGRES_USER=ai_teacher_local
POSTGRES_PASSWORD=change-this-local-postgres-password
RABBITMQ_DEFAULT_USER=ai_teacher_local
RABBITMQ_DEFAULT_PASS=change-this-local-rabbitmq-password
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
BACKEND_PORT=8000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
LIVEKIT_PORT=7880

